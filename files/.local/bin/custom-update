#!/usr/bin/env python3
"""Install the published fixes for this system (2026-10-03; two release lines since 2026-10-04).

Two kinds of fixes, two numbered release lines in one GitHub repo:
  system fixes   tags system-<label>  fixes needed because of (or to go with) updates to Arch, Hyprland or
                                      illogical-impulse. Always on: they install with every system update, right
                                      after the packages/shell they belong to, and only when the installed versions
                                      match ("requires", e.g. hyprland>=0.57). A system fix can patch a custom file:
                                      it carries one patch per custom-version range and applies the one that fits the
                                      installed custom version; if none fits, that file is left unchanged (reported).
  custom fixes   tags custom-<label>  fixes for the custom additions (hypr-guard, Wallpaper Engine, Settings, the
                                      setup assistant, …). Optional: extras.customFixes (the setup wizard asks).
                                      A new whole number (1 -> 2) is a major version: only offered, never automatic.

  custom-update status              both lines: on/off, installed, source
  custom-update check [--quiet]     anything to install? (exit 0 = yes: a custom fix or a system fix; 1 = no; 2 = off/error)
  custom-update apply [--yes]       install the newest custom bug fix for the installed version
  custom-update system-apply        install every system fix that matches this system (run by system-update)
  custom-update offers [--json]     what's available: system fixes (ready / waiting), custom fix, major version
  custom-update upgrade <ver> [--yes]  move to a new major custom version (only when you ask)
  custom-update undo                put back the files from before the last custom install
  custom-update consent yes|no      custom fixes on/off (the setup wizard and Settings › Update do this)
  custom-update test-channel on|off also see test releases
  custom-update whats-new [--seen]  notes of the fixes installed since they were last read (JSON); --seen marks them read

Releases live in the repo named in ~/.local/share/custom-fixes/source.json: a signed index (release "index":
index.json + .sig) listing both lines, and per release manifest.json (+ .sig) and a payload tarball. Signatures are
ssh-keygen ones checked against ~/.local/share/custom-fixes/allowed_signers. A release never contains settings or
personal files. A file you changed yourself is never overwritten: the new version is saved next to it as
<file>.fixes-new. On the PC that publishes (~/.local/state/custom-fixes-publisher exists) this does nothing.
"""
import datetime
import hashlib
import io
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request

HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "illogical-impulse", "config.json")
SHARE = os.path.join(HOME, ".local", "share", "custom-fixes")
SOURCE = os.path.join(SHARE, "source.json")
SIGNERS = os.path.join(SHARE, "allowed_signers")
BASE = os.path.join(SHARE, "base.json")          # version the clone was built with (written by custom-publish)
STATE = os.path.join(HOME, ".local", "state", "custom-fixes")
INSTALLED = os.path.join(STATE, "installed.json")      # custom line
SYSTEM = os.path.join(STATE, "system.json")            # system line: {"applied": {label: {...}}}
WHATSNEW = os.path.join(STATE, "whats-new.json")        # notes of installed releases not read yet (Settings › Update)
SCHEME = 2                                             # 2 = two release lines (custom-*/system-* tags)
PUBLISHER = os.path.join(HOME, ".local", "state", "custom-fixes-publisher")
NAMESPACE = "custom-fixes"
RISK = ("A major version changes how parts of the desktop work and may break the existing setup "
        "(for example, local changes to the files it replaces). The current files are backed up first, "
        "and the upgrade can be reverted in Settings › Update.")


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def extras():
    return load(CONFIG, {}).get("extras") or {}


def consent():
    return extras().get("customFixes", False) is True


def test_channel():
    return extras().get("customFixesTest", False) is True


def set_extra(key, on):
    cfg = load(CONFIG, None)
    if cfg is None:
        sys.exit("custom-update: no shell config yet")
    cfg.setdefault("extras", {})[key] = on
    save(CONFIG, cfg)


def source():
    s = load(SOURCE, {})
    return s if s.get("repo") else None


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "custom-update", "Cache-Control": "no-cache"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read()


def verified(src, data, sig):
    with tempfile.TemporaryDirectory() as d:
        sigf = os.path.join(d, "x.sig")
        with open(sigf, "wb") as f:
            f.write(sig)
        r = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", SIGNERS, "-I", src["signer"], "-n", NAMESPACE, "-s", sigf],
                           input=data, capture_output=True)
    if r.returncode != 0:
        raise RuntimeError("the release signature is not valid; nothing was installed")
    return json.loads(data)


def fetch_index_files(src):
    """index.json + .sig. The index is re-uploaded under the same name on every release, and the plain download
    address is cached for minutes, so read the uploads by their unique API ids (fallback: the plain address)."""
    try:
        rel = json.loads(fetch(f"https://api.github.com/repos/{src['repo']}/releases/tags/index"))
        urls = {a["name"]: a["url"] for a in rel.get("assets", [])}
        def get(name):
            req = urllib.request.Request(urls[name], headers={"User-Agent": "custom-update", "Accept": "application/octet-stream"})
            with urllib.request.urlopen(req, timeout=60) as r:
                return r.read()
        return get("index.json"), get("index.json.sig")
    except Exception:   # API unreachable or rate-limited (60 requests/hour)
        base = f"https://github.com/{src['repo']}/releases/download/index"
        return fetch(f"{base}/index.json"), fetch(f"{base}/index.json.sig")


def release_index(src):
    """Signed list of every release: [{label, version, kind, test, date, notes, upgrade?}]."""
    idx = verified(src, *fetch_index_files(src))
    if idx.get("format") != "custom-fixes-index":
        raise RuntimeError("not a release index")
    return idx["releases"]


def release(src, label, line="custom"):
    base = f"https://github.com/{src['repo']}/releases/download/{line}-{label}"
    m = verified(src, fetch(f"{base}/manifest.json"), fetch(f"{base}/manifest.json.sig"))
    if m.get("format") != ("system-fix" if line == "system" else "custom-fixes") or m.get("line", "custom") != line:
        raise RuntimeError("not a release of the expected kind")
    return m, base


def line_index(src, line):
    return [r for r in release_index(src) if r.get("line") == line and (test_channel() or not r.get("test"))]


def cents(v):
    return round(float(v or 0) * 100)


def vkey(v):
    """Release, manifest, installed record or label -> (series, number). The label is authoritative: "2" -> (2, 0),
    "1.3" -> (1, 30), "1.31" -> (1, 31), "1.104" -> (1, 104) (three digits once a series passes 1.99, so fixes never
    spill into the next whole number). Records without a label fall back to the decimal "version"."""
    if isinstance(v, dict):
        lab = str(v.get("label") or "")
        if not lab:
            c = round(float(v.get("version") or 0) * 100)
            return divmod(c, 100)
        v = lab
    v = str(v).removesuffix("-test")
    whole, _, frac = v.partition(".")
    if not whole.isdigit() or (frac and not frac.isdigit()):
        return (0, 0)
    n = int(frac) * 10 if len(frac) == 1 else int(frac or 0)
    return (int(whole), n)


def vfmt(key):
    """(series, number) -> label: (1, 30) -> "1.3", (1, 31) -> "1.31", (1, 104) -> "1.104", (2, 0) -> "2"."""
    series, n = key
    if n == 0:
        return str(series)
    if n >= 100:
        return f"{series}.{n}"
    return f"{series}.{n // 10}" if n % 10 == 0 else f"{series}.{n:02d}"


def vcompat(key):
    """Decimal "version" for updaters that predate labels (they read it as a number): at most x.99, so a release
    numbered x.100 or higher still counts as a bug fix there (it installs the new updater, which reads labels)."""
    series, n = key
    return round(series + min(n, 99) / 100, 2)


def vlabel(m):
    return str(m.get("label") or m.get("version"))


def installed():
    """Custom line record. Systems from before the two release lines (installed.json / base.json without "scheme")
    are on an old numbering: they count as custom 1 minus a step, so custom-1 is offered to them as a normal fix."""
    inst = load(INSTALLED, None)
    if inst is None:   # nothing installed by this tool yet: the files are the ones the clone was built with
        b = load(BASE, {})
        inst = {"version": b.get("version", 0), "label": b.get("label", ""), "files": {}, "scheme": b.get("scheme")}
    inst.setdefault("files", {})
    if inst.get("scheme") != SCHEME:
        inst = {"version": 0, "label": "", "files": inst["files"], "legacy": True}
    return inst


def shell_ready(r):
    """A custom release made on a newer illogical-impulse shell than this system has waits until the shell is
    updated (the update button updates it first). Releases without the field fit any shell."""
    commit = r.get("shell")
    if not commit:
        return True
    repo = os.path.join(HOME, ".config", "quickshell", "end4-pC")
    return subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", commit, "HEAD"],
                          capture_output=True).returncode == 0


def cur_key(inst):
    return (1, -1) if inst.get("legacy") else vkey(inst)


# ── system line ──────────────────────────────────────────────────────────────────────────────────────────────────
SHELL_REPO = os.path.join(HOME, ".config", "quickshell", "end4-pC")


def system_usable():
    return not os.path.isdir(PUBLISHER) and bool(source())


def system_state():
    return load(SYSTEM, {"applied": {}})


def applied_system():
    """System fixes already on this system: applied here, or already part of the files it was installed from."""
    done = set(system_state()["applied"]) | set(load(BASE, {}).get("system", []))
    return sorted(done, key=vkey)


def partial_system():
    """Applied system fixes that had to leave a file unchanged (no variant for the custom version installed then)."""
    cur = installed().get("label") or ""
    return [{"label": lab, "skipped": e["skipped"]} for lab, e in system_state()["applied"].items()
            if e.get("skipped") and e.get("customAtApply") == cur]


def pkg_version(name):
    r = subprocess.run(["pacman", "-Q", name], capture_output=True, text=True)
    return r.stdout.split()[1] if r.returncode == 0 and len(r.stdout.split()) > 1 else None


def requirement(req):
    """One requirement -> (met, reason). "hyprland>=0.57" (also >, <=, <, =) compares the installed package with
    vercmp; "end4-pC@<commit>" needs the illogical-impulse shell to contain that commit."""
    if req.startswith("end4-pC@"):
        commit = req.split("@", 1)[1]
        r = subprocess.run(["git", "-C", SHELL_REPO, "merge-base", "--is-ancestor", commit, "HEAD"], capture_output=True)
        return r.returncode == 0, f"needs a newer illogical-impulse shell ({commit[:8]})"
    for op in (">=", "<=", ">", "<", "="):
        if op in req:
            name, want = req.split(op, 1)
            break
    else:
        name, want, op = req, "", ""
    have = pkg_version(name.strip())
    if have is None:
        return False, f"{name.strip()} is not installed"
    if not op:
        return True, ""
    c = int(subprocess.run(["vercmp", have, want.strip()], capture_output=True, text=True).stdout.strip() or 0)
    met = {">=": c >= 0, "<=": c <= 0, ">": c > 0, "<": c < 0, "=": c == 0}[op]
    return met, f"for {name.strip()} {op} {want.strip()} (installed: {have})"


def system_offers(src):
    """{"pending": ready to install, "waiting": [{label, reason}] (versions don't match yet)}."""
    done = set(applied_system())
    pending, waiting = [], []
    for r in sorted(line_index(src, "system"), key=vkey):
        if r["label"] in done:
            continue
        unmet = [why for met, why in (requirement(q) for q in r.get("requires", [])) if not met]
        if unmet:
            waiting.append({"label": r["label"], "reason": "; ".join(unmet), "notes": r.get("notes", [])})
        else:
            pending.append(r)
    return {"pending": pending, "waiting": waiting}


def in_range(key, variant):
    lo = vkey(variant["min"]) if variant.get("min") else (0, -1)
    hi = vkey(variant["max"]) if variant.get("max") else (10 ** 6, 0)
    return lo <= key <= hi


def install_system(src, entry):
    lab = entry["label"]
    try:
        m, base = release(src, lab, "system")
        payload = fetch(f"{base}/{m['payload']}")
    except Exception as e:
        print(f"System fix {lab}: download failed ({e})")
        return 1
    if hashlib.sha256(payload).hexdigest() != m["payloadSha256"]:
        print(f"System fix {lab}: the download is corrupted; nothing was installed.")
        return 1
    unmet = [why for met, why in (requirement(q) for q in m.get("requires", [])) if not met]
    if unmet:                                    # the signed manifest is authoritative, not just the index
        print(f"System fix {lab}: not for this system ({'; '.join(unmet)}).")
        return 0
    # everything checked before anything changes: whole files and every patch variant present with their checksums
    blobs, problems = {}, []
    try:
        with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as tar:
            wanted = dict(m.get("files", {}))
            for pt in m.get("patches", []):
                for v in pt["variants"]:
                    wanted[v["patch"]] = v["sha256"]
            for rel, digest in wanted.items():
                if rel.startswith("/") or ".." in rel.split("/"):
                    problems.append(f"{rel}: unsafe path")
                    continue
                try:
                    member = tar.getmember(rel)
                    data = tar.extractfile(member).read()
                except (KeyError, AttributeError):
                    problems.append(f"{rel}: missing from the download")
                    continue
                if hashlib.sha256(data).hexdigest() != digest:
                    problems.append(f"{rel}: checksum mismatch")
                    continue
                blobs[rel] = (data, member.mode & 0o777)
    except (tarfile.TarError, OSError, EOFError) as e:
        problems.append(f"the download can't be read ({e})")
    if problems:
        print(f"System fix {lab} is incomplete or damaged; nothing was installed:")
        for pr in problems[:10]:
            print(f"  {pr}")
        return 1

    inst = installed()
    custom_key = cur_key(inst)
    backup = os.path.join(STATE, "backups", f"system-{lab}")
    shutil.rmtree(backup, ignore_errors=True)
    changed, kept, skipped = [], [], []

    def back_up(rel):
        dst = os.path.join(HOME, rel)
        if os.path.exists(dst):
            os.makedirs(os.path.dirname(os.path.join(backup, rel)), exist_ok=True)
            shutil.copy2(dst, os.path.join(backup, rel))

    for rel, digest in m.get("files", {}).items():          # files that belong to the system line
        data, mode = blobs[rel]
        dst = os.path.join(HOME, rel)
        if os.path.exists(dst):
            cur = sha256(dst)
            if cur == digest:
                continue
            if rel in inst["files"] and cur != inst["files"][rel]:   # edited by the user
                with open(dst + ".fixes-new", "wb") as f:
                    f.write(data)
                kept.append(rel)
                continue
            back_up(rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        tmp = dst + ".fixes-tmp"
        with open(tmp, "wb") as f:
            f.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, dst)
        changed.append(rel)
    for pt in m.get("patches", []):                          # changes to custom files: the variant for this version
        rel = pt["file"]
        variant = next((v for v in pt["variants"] if in_range(custom_key, v)), None)
        if not variant:
            skipped.append({"file": rel, "reason": "no variant for the installed custom version"})
            continue
        with tempfile.NamedTemporaryFile("wb", suffix=".patch", delete=False) as tf:
            tf.write(blobs[variant["patch"]][0])
        try:
            done = subprocess.run(["patch", "-p1", "-R", "-s", "-f", "--dry-run", "-d", HOME, "-i", tf.name], capture_output=True)
            if done.returncode == 0:     # this custom version already contains the change
                continue
            dry = subprocess.run(["patch", "-p1", "-N", "-s", "-f", "--dry-run", "-d", HOME, "-i", tf.name], capture_output=True)
            if dry.returncode != 0:
                skipped.append({"file": rel, "reason": "the change does not fit this file (edited, or another version)"})
                continue
            back_up(rel)
            subprocess.run(["patch", "-p1", "-N", "-s", "-f", "--no-backup-if-mismatch", "-d", HOME, "-i", tf.name],
                           check=True, capture_output=True)
            changed.append(rel)
        finally:
            os.unlink(tf.name)

    # files a system fix changed are not the user's edits: remember their new content, so a later custom update
    # recognizes them as unedited and replaces them (its version contains the same change)
    st = system_state()
    st.setdefault("changed", {})
    for rel in changed:
        p = os.path.join(HOME, rel)
        if os.path.exists(p):
            st["changed"][rel] = sha256(p)
    st["applied"][lab] = {"date": datetime.datetime.now().isoformat(timespec="seconds"), "changed": changed,
                          "kept": kept, "skipped": skipped, "customAtApply": inst.get("label") or ""}
    save(SYSTEM, st)
    record_whats_new(src, "system", None, m)
    print(f"System fix {lab}: {len(changed)} file(s) updated." + "".join(f"\n  - {n}" for n in m.get("notes", [])))
    for rel in kept:
        print(f"  kept the locally modified ~/{rel} (the new version is saved as ~/{rel}.fixes-new)")
    for sk in skipped:
        print(f"  left ~/{sk['file']} unchanged: {sk['reason']}. Updating the custom fixes completes this fix.")
    return 0


def cmd_system_apply():
    if os.path.isdir(PUBLISHER):
        print("This system publishes the fixes (custom-publish); nothing to install.")
        return 0
    src = source()
    if not src:
        print("No fixes source is configured.")
        return 0
    try:
        o = system_offers(src)
    except Exception as e:
        print(f"Checking for system fixes failed: {e}")
        return 1
    if not o["pending"]:
        print("System fixes: nothing to install." + (f" Waiting: {', '.join(w['label'] for w in o['waiting'])}." if o["waiting"] else ""))
        return 0
    rc, any_changed = 0, False
    for r in o["pending"]:
        rc |= install_system(src, r)
        any_changed = True
    if any_changed:
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            subprocess.run(["hyprctl", "reload"], capture_output=True)
        guard = os.path.join(HOME, ".local", "bin", "hypr-guard")
        if os.access(guard, os.X_OK):
            subprocess.run([guard, "snapshot", "--force"], capture_output=True)
    return rc


def offers(src):
    """{'fix': entry|None, 'upgrade': entry|None} for this PC."""
    cur = cur_key(installed())
    major = cur[0]
    rel = line_index(src, "custom")
    skip = installed().get("skip")          # a fix the user undid: it and older ones are not offered again
    fixes = [r for r in rel if vkey(r) > cur and vkey(r)[0] == major and not (skip and vkey(r) <= vkey(skip))
             and shell_ready(r)]
    higher = [r for r in rel if vkey(r)[0] > major]
    fix = max(fixes, key=vkey, default=None)
    held = [r for r in rel if vkey(r) > cur and vkey(r)[0] == major and not (skip and vkey(r) <= vkey(skip))
            and not shell_ready(r)]
    waiting = max(held, key=vkey) if held and (not fix or vkey(max(held, key=vkey)) > vkey(fix)) else None
    upgrade = None
    if higher:
        top_major = max(vkey(r)[0] for r in higher)
        line = [r for r in higher if vkey(r)[0] == top_major]
        newest = max(line, key=vkey)                                    # install the newest of that line
        intro = next((r for r in line if r.get("upgrade")), newest)    # the release that introduced it explains it
        upgrade = dict(newest, upgrade=intro.get("upgrade") or {}, major=top_major)
    return {"fix": fix, "upgrade": upgrade, "waiting": waiting}


def cmd_status():
    src = source()
    inst = installed()
    pub = "  (this system publishes them)" if os.path.isdir(PUBLISHER) else ""
    print(f"source:         {src['repo'] if src else 'not configured'}")
    print(f"system fixes:   always on{pub}; applied: {', '.join(applied_system()) or 'none'}")
    print(f"custom fixes:   {'on' if consent() else 'off'}{pub}" + ("  (test releases on)" if test_channel() else ""))
    print(f"custom version: {('v' + inst['label']) if inst.get('label') else ('from before the release reset' if inst.get('legacy') else 'none')}")


def usable():
    return not os.path.isdir(PUBLISHER) and consent() and source()


def cmd_check(quiet=False):
    if not system_usable():
        return 2
    try:
        pending = system_offers(source())["pending"]
        fix = offers(source())["fix"] if usable() else None
    except Exception as e:
        if not quiet:
            print(f"Checking for fixes failed: {e}")
        return 2
    if pending and not quiet:
        for r in pending:
            print(f"system fix {r['label']}: {'; '.join(r.get('notes', []))}")
    if pending and not fix:
        return 0
    if fix:
        if not quiet:
            print(f"v{fix['label']} ({fix.get('date', '')}):")
            for n in fix.get("notes", []):
                print(f"  - {n}")
        return 0
    if not quiet:
        inst = installed()
        print(f"Up to date (v{inst.get('label') or inst['version']}).")
    return 1


def cmd_offers(as_json):
    out = {"installed": installed().get("label") or "", "fix": None, "upgrade": None,
           "risk": RISK, "enabled": bool(usable()), "error": "",
           "system": {"enabled": bool(system_usable()), "applied": applied_system(), "pending": [], "waiting": [],
                      "partial": partial_system(), "error": ""}}
    if system_usable():
        try:
            out["system"].update(system_offers(source()))
        except Exception as e:
            out["system"]["error"] = str(e)
    if usable():
        try:
            out.update(offers(source()))
        except Exception as e:
            out["error"] = str(e)
    if as_json:
        print(json.dumps(out))
    else:
        sy = out["system"]
        print(f"system:    ready {', '.join(r['label'] for r in sy['pending']) or 'none'}; "
              f"waiting {', '.join(w['label'] + ' (' + w['reason'] + ')' for w in sy['waiting']) or 'none'}"
              + "".join(f"; {p['label']} partly applied ({len(p['skipped'])} file(s) need newer custom fixes)" for p in sy['partial']))
        print(f"installed: {('v' + out['installed']) if out['installed'] else 'none'}")
        print(f"bug fix:   {'v' + out['fix']['label'] if out['fix'] else 'none'}"
              + (f"  (v{out['waiting']['label']} waits for an illogical-impulse update)" if out.get("waiting") else ""))
        u = out["upgrade"]
        print(f"upgrade:   {('version ' + str(u['major']) + ' (v' + u['label'] + '): ' + u['upgrade'].get('title', '')) if u else 'none'}")
        if out["error"]:
            print(f"error:     {out['error']}")
    return 0


def baseline(src):
    """sha256 of every file as it came with this installation: the signed manifest of the release named in base.json
    (the clone was built from it). Cached; None when it can't be had (offline, no label), and then files that this
    tool never installed are replaced with a backup, as before."""
    cache = os.path.join(STATE, "baseline.json")
    lab = load(BASE, {}).get("label")
    if not lab:
        return None
    c = load(cache, None)
    if c and c.get("label") == lab:
        return c["files"]
    try:
        m, _ = release(src, lab)
    except Exception:
        return None
    save(cache, {"label": lab, "files": m.get("files", {})})
    return m.get("files", {})


def install(src, label, yes, what):
    try:
        m, base = release(src, label)
    except Exception as e:
        print(f"Downloading version {label} failed: {e}")
        return 1
    if not shell_ready(m):          # the signed manifest is authoritative
        print(f"{what} v{vlabel(m)} needs a newer illogical-impulse shell; it installs after the next update.")
        return 0
    inst = installed()
    print(f"{what} v{vlabel(m)}:")
    for n in m.get("notes", []):
        print(f"  - {n}")
    if not yes and sys.stdin.isatty() and input("Install? [Y/n] ").strip().lower() == "n":
        return 0
    try:
        payload = fetch(f"{base}/{m['payload']}")
    except Exception as e:
        print(f"Download failed: {e}")
        return 1
    if hashlib.sha256(payload).hexdigest() != m["payloadSha256"]:
        print("The download is corrupted (checksum mismatch); nothing was installed.")
        return 1

    # check the whole release before changing anything: every listed file present with the right checksum
    contents, problems = {}, []
    try:
        with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as tar:
            for rel, digest in m["files"].items():
                if rel.startswith("/") or ".." in rel.split("/"):
                    continue
                try:
                    member = tar.getmember(rel)
                    data = tar.extractfile(member).read()
                except (KeyError, AttributeError):
                    problems.append(f"{rel}: missing from the download")
                    continue
                if hashlib.sha256(data).hexdigest() != digest:
                    problems.append(f"{rel}: checksum mismatch")
                    continue
                contents[rel] = (data, member.mode & 0o777)
    except (tarfile.TarError, OSError, EOFError) as e:
        problems.append(f"the download can't be read ({e})")
    if problems:
        print(f"Version {vlabel(m)} is incomplete or damaged; nothing was installed:")
        for p in problems[:10]:
            print(f"  {p}")
        return 1

    backup = os.path.join(STATE, "backups", f"v{vlabel(m)}")
    shutil.rmtree(backup, ignore_errors=True)
    changed, kept, record = [], [], dict(inst["files"])
    base_files = None if all(r in inst["files"] for r in m["files"]) else baseline(src)
    for rel, (data, mode) in contents.items():
        digest = m["files"][rel]
        dst = os.path.join(HOME, rel)
        if os.path.exists(dst):
            cur = sha256(dst)
            if cur == digest:
                record[rel] = digest
                continue
            edited = (cur != inst["files"][rel]) if rel in inst["files"] else \
                (base_files is not None and cur != base_files.get(rel))   # vs. how it came with the install
            if edited and system_state().get("changed", {}).get(rel) == cur:
                edited = False                                   # changed by a system fix, not by the user
            if edited:
                # changed by the user (since the last fix, or since installation): keep theirs, put ours next to it
                with open(dst + ".fixes-new", "wb") as f:
                    f.write(data)
                kept.append(rel)
                continue
            os.makedirs(os.path.dirname(os.path.join(backup, rel)), exist_ok=True)
            shutil.copy2(dst, os.path.join(backup, rel))
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        tmp = dst + ".fixes-tmp"
        with open(tmp, "wb") as f:
            f.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, dst)
        record[rel] = digest
        changed.append(rel)
    prev_key = cur_key(inst)
    save(INSTALLED, {"scheme": SCHEME, "version": m["version"], "label": vlabel(m), "previous": inst["version"],
                     "previousLegacy": bool(inst.get("legacy")),
                     "previousLabel": inst.get("label") or str(inst["version"]), "date": m.get("date", ""),
                     "files": record, "changed": changed, "installedAt": datetime.datetime.now().isoformat(timespec="seconds")})

    if any(r.startswith(".config/hypr/") for r in changed) and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], capture_output=True)
    guard = os.path.join(HOME, ".local", "bin", "hypr-guard")
    if changed and os.access(guard, os.X_OK):
        subprocess.run([guard, "snapshot", "--force"], capture_output=True)   # the fixes are the new known-good state
    record_whats_new(src, "custom", prev_key, m)
    print(f"Installed version {vlabel(m)}: {len(changed)} file(s) updated.")
    for rel in kept:
        print(f"  kept the locally modified ~/{rel} (the new version is saved as ~/{rel}.fixes-new)")
    return 0


def record_whats_new(src, line, prev_key, m):
    """After an install: keep the notes of every release of this line from the previous version up to the installed
    one (an update can skip several versions), added to what is still unread, and announce it."""
    try:
        rels = [r for r in line_index(src, line) if prev_key is None or prev_key < vkey(r) <= vkey(m)]
    except Exception:
        rels = []
    if prev_key is None or not rels:
        rels = [m]
    items = [{"line": line, "label": vlabel(r), "date": r.get("date", ""), "notes": list(r.get("notes", []))}
             for r in sorted(rels, key=vkey) if r.get("notes")]
    if not items:
        return
    data = load(WHATSNEW, {})
    old = data.get("items", []) if not data.get("seen", True) else []
    have = {(i["line"], i["label"]) for i in old}
    data = {"seen": False, "items": (old + [i for i in items if (i["line"], i["label"]) not in have])[-30:]}
    save(WHATSNEW, data)
    name = "Phoenix updated" if line == "custom" else "System fix installed"
    first = items[-1]["notes"][0]
    body = (first if len(first) <= 140 else first[:137] + "…") + "\nSettings › Update shows what's new."
    try:
        subprocess.run(["notify-send", "-a", "Phoenix", "-i", "system-software-update",
                        f"{name}: {vlabel(m)}", body], capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def cmd_whats_new(mark_seen):
    data = load(WHATSNEW, {"seen": True, "items": []})
    if mark_seen and not data.get("seen", True):
        data["seen"] = True
        save(WHATSNEW, data)
    print(json.dumps({"unread": not data.get("seen", True), "items": data.get("items", [])}))
    return 0


def cmd_apply(yes):
    if os.path.isdir(PUBLISHER):
        print("This system publishes the fixes (custom-publish); nothing to install.")
        return 0
    if not consent():
        print("Custom fixes are disabled (enable them in Settings › Update).")
        return 0
    src = source()
    if not src:
        print("No fixes source is configured.")
        return 0
    try:
        o = offers(src)
    except Exception as e:
        print(f"Downloading fixes failed: {e}")
        return 1
    if o["upgrade"]:
        print(f"Version {o['upgrade']['major']} is available; see Settings › Update for details and to upgrade.")
    if not o["fix"]:
        inst = installed()
        print(f"Custom fixes: up to date (v{inst.get('label') or inst['version']}).")
        return 0
    return install(src, o["fix"]["label"], yes, "Custom fixes")


def open_in_terminal(args, title):
    """Run this command again in a terminal window (graphical session only). True when a window was opened."""
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        return False
    me = os.path.realpath(sys.argv[0])
    for term, flags in (("kitty", ["--title", title, "--"]), ("foot", ["--title", title]),
                        ("konsole", ["-e"]), ("xterm", ["-T", title, "-e"])):
        if shutil.which(term):
            subprocess.Popen([term, *flags, me, *args, "--pause"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
    return False


def pause_if(asked):
    if asked and sys.stdin.isatty():
        try:
            input("\nPress Enter to close this window.")
        except EOFError:
            pass


def cmd_upgrade(label, yes):
    if os.path.isdir(PUBLISHER):
        print("This system publishes the fixes (custom-publish); nothing to install.")
        return 0
    if not usable():
        print("Custom fixes are disabled or not configured.")
        return 1
    src = source()
    try:
        o = offers(src)
    except Exception as e:
        print(f"Checking for versions failed: {e}")
        return 1
    u = o["upgrade"]
    if not u or (label and label not in (u["label"], str(u["major"]))):
        print("That version is not offered to this system.")
        return 1
    print(f"Upgrade to version {u['major']}: {u['upgrade'].get('title', '')}")
    print(u["upgrade"].get("summary", ""))
    print("\n" + RISK + "\n")
    if not yes:
        if not sys.stdin.isatty():   # no one to ask here (script, background process): ask in a terminal window
            if open_in_terminal(["upgrade", u["label"]], f"Upgrade to version {u['major']}"):
                print(f"Opened a terminal window to confirm the upgrade to version {u['major']}.")
                return 0
            print("Not upgraded: confirmation needed. Run this in a terminal, or add --yes.")
            return 1
        try:
            if input("Upgrade now? [y/N] ").strip().lower() != "y":
                print("Not upgraded.")
                return 0
        except EOFError:
            print("\nNot upgraded.")
            return 1
    return install(src, u["label"], True, f"Version {u['major']}")


def cmd_undo():
    inst = installed()
    backup = os.path.join(STATE, "backups", f"v{inst.get('label') or inst['version']}")
    if not inst["version"] or not os.path.isdir(backup):
        print("Nothing to undo.")
        return 0
    restored = 0
    for root, _, files in os.walk(backup):
        for f in files:
            src = os.path.join(root, f)
            rel = os.path.relpath(src, backup)
            shutil.copy2(src, os.path.join(HOME, rel))
            inst["files"].pop(rel, None)
            restored += 1
    # files that were new in that release are left in place; versions before it are restored. The undone version is
    # remembered so updates don't reinstall it; a newer release is offered as usual (and contains its changes too).
    undone = inst.get("label") or str(inst["version"])
    rec = {"scheme": SCHEME, "version": inst.get("previous", 0), "label": inst.get("previousLabel", ""),
           "files": inst["files"], "skip": undone}
    if inst.get("previousLegacy"):
        rec.update(label="", legacy=True)        # back to "from before the release reset" (counts as custom 1 minus a step)
    save(INSTALLED, rec)
    guard = os.path.join(HOME, ".local", "bin", "hypr-guard")
    if restored and os.access(guard, os.X_OK):     # the restored files are the known-good state now; otherwise the
        subprocess.run([guard, "snapshot", "--force"], capture_output=True)   # login check would put the fix back
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], capture_output=True)
    print(f"Reverted version {undone}: {restored} file(s) restored. Updates will not reinstall it; the next newer "
          "release is offered as usual and includes its changes again.")
    return 0


def phoenix_inactive():
    """Phoenix installed with install.sh but switched off (phoenix deactivate): the user's own illogical-impulse files
    are in place, so nothing may be installed over them."""
    try:
        with open(os.path.join(HOME, ".local", "state", "phoenix", "active")) as f:
            return f.read().strip() == "no"
    except OSError:
        return False


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "status"
    if cmd in ("apply", "system-apply", "upgrade", "undo") and phoenix_inactive():
        print("Phoenix is switched off (phoenix activate turns it on); no fixes are installed while it is off.")
        sys.exit(0)
    if cmd == "status":
        cmd_status()
    elif cmd == "check":
        sys.exit(cmd_check("--quiet" in a))
    elif cmd == "apply":
        sys.exit(cmd_apply("--yes" in a))
    elif cmd == "system-apply":
        sys.exit(cmd_system_apply())
    elif cmd == "offers":
        sys.exit(cmd_offers("--json" in a))
    elif cmd == "upgrade":
        label = next((x for x in a[1:] if not x.startswith("-")), "")
        rc = cmd_upgrade(label, "--yes" in a)
        pause_if("--pause" in a)       # opened in its own terminal window: keep the result readable
        sys.exit(rc)
    elif cmd == "undo":
        sys.exit(cmd_undo())
    elif cmd == "consent" and len(a) == 2 and a[1] in ("yes", "no"):
        set_extra("customFixes", a[1] == "yes")
        print(f"Custom fixes: {'enabled' if a[1] == 'yes' else 'disabled'}")
    elif cmd == "whats-new":
        sys.exit(cmd_whats_new("--seen" in a))
    elif cmd == "test-channel" and len(a) == 2 and a[1] in ("on", "off"):
        set_extra("customFixesTest", a[1] == "on")
        print(f"Test releases: {a[1]}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
