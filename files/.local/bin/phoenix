#!/usr/bin/env bash
# phoenix: switch Phoenix on or off, or remove it (2026-10-04). Installed by install.sh from github.com/RandomRandomnes/phoenix
#
#   phoenix status               installed? active? versions
#   phoenix activate             use the Phoenix shell (your own illogical-impulse setup is kept aside)
#   phoenix deactivate           back to your own illogical-impulse setup (Phoenix is kept aside)
#   phoenix uninstall [--yes]    remove Phoenix and put back everything it replaced
#   phoenix login-screen [install|remove|status]
#                                a Phoenix-style login screen at startup (greetd) instead of signing in automatically
#   phoenix power-meter [install|remove|status]
#                                CPU power for the system stats: a small root service that publishes a coarse reading
#                                (1 s average, 0.5 W steps), so the energy counter itself stays root-only
#
# Phoenix and illogical-impulse share two things: the Hyprland user folder ~/.config/hypr/custom and the shell settings
# ~/.config/illogical-impulse/config.json. Switching swaps those two between the active side and a copy kept in
# ~/.local/state/phoenix/{phoenix-side,user-side}; nothing is deleted. Everything else Phoenix installs (the end4-pC
# shell, the helper commands, profiles, the guide) stays in place and does nothing while Phoenix is inactive.
set -uo pipefail
STATE="$HOME/.local/state/phoenix"
SWAP=(".config/hypr/custom" ".config/illogical-impulse/config.json")
B=$'\e[1m'; N=$'\e[0m'
die() { echo "phoenix: $*" >&2; exit 1; }
active() { [ "$(cat "$STATE/active" 2>/dev/null)" = yes ]; }
installed() { [ -f "$STATE/installed.json" ]; }

need_installer_install() {
    installed && return 0
    if [ -f "$HOME/.local/share/custom-fixes/base.json" ]; then
        die "this system was installed from the Phoenix image; Phoenix is the system's desktop and can't be switched off here"
    fi
    die "Phoenix is not installed (see https://github.com/RandomRandomnes/phoenix)"
}

# move the shared items of the active side to $1 (a state folder) and bring the ones in $2 into place
swap() {
    local away="$1" back="$2" item
    for item in "${SWAP[@]}"; do
        mkdir -p "$(dirname "$away/$item")" "$(dirname "$HOME/$item")"
        rm -rf "$away/$item"
        [ -e "$HOME/$item" ] && mv "$HOME/$item" "$away/$item"
        [ -e "$back/$item" ] && mv "$back/$item" "$HOME/$item"
    done
}

qs_config_of_ii() {   # the shell illogical-impulse starts on its own (its variables.lua; "ii" when unset)
    sed -n 's/^hl.env("qsConfig", *"\([^"]*\)").*/\1/p' "$HOME/.config/hypr/hyprland/variables.lua" 2>/dev/null | tail -1 | grep . || echo ii
}

restart_shell() {     # $1 = quickshell config to run now
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || { echo "Log in to Hyprland to use it."; return; }
    hyprctl reload >/dev/null 2>&1
    # every running instance belongs to the side being left (its bar, the setup assistant, Settings): stop them all;
    # a plain `qs kill` only stops the default config's instance
    local pid
    for pid in $(LC_ALL=C.UTF-8 qs list --all 2>/dev/null | awk '/Process ID:/ {print $3}'); do
        qs kill --pid "$pid" >/dev/null 2>&1
    done
    sleep 1
    hyprctl dispatch "hl.dsp.exec_cmd(\"qs -c $1\")" >/dev/null 2>&1
    echo "The shell was restarted. Log out and back in once to finish switching (login programs, title bars)."
}

cmd_status() {
    if ! installed; then
        [ -f "$HOME/.local/share/custom-fixes/base.json" ] && echo "Phoenix: installed from the Phoenix image (always active)" \
            || echo "Phoenix: not installed"
        return
    fi
    local custom; custom=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('label',''))" \
        "$HOME/.local/state/custom-fixes/installed.json" 2>/dev/null || python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('label',''))" "$HOME/.local/share/custom-fixes/base.json" 2>/dev/null)
    echo "Phoenix:      installed $(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['date'])" "$STATE/installed.json")"
    echo "State:        $(active && echo "${B}active${N} (Phoenix shell)" || echo "inactive (your illogical-impulse setup)")"
    echo "Custom fixes: ${custom:-unknown}"
    echo "Shell:        end4-pC $(git -C "$HOME/.config/quickshell/end4-pC" rev-parse --short HEAD 2>/dev/null || echo '?')"
}

cmd_activate() {
    need_installer_install
    active && { echo "Phoenix is already active."; return; }
    swap "$STATE/user-side" "$STATE/phoenix-side"
    echo yes > "$STATE/active"
    echo "Phoenix is active. Your own illogical-impulse files are kept in $STATE/user-side."
    restart_shell end4-pC
}

cmd_deactivate() {
    need_installer_install
    active || { echo "Phoenix is already inactive."; return; }
    swap "$STATE/phoenix-side" "$STATE/user-side"
    echo no > "$STATE/active"
    echo "Phoenix is inactive; your own illogical-impulse setup is back. Switch again with: phoenix activate"
    restart_shell "$(qs_config_of_ii)"
}

cmd_uninstall() {
    need_installer_install
    if [ "${1:-}" != --yes ]; then
        read -r -p "Remove Phoenix and restore what it replaced? [y/N] " a
        [[ "$a" =~ ^[yY] ]] || { echo "Nothing changed."; return; }
    fi
    [ -f "$METER_UNIT" ] && cmd_power_meter remove   # the root service, if it was installed (asks for the password)
    active && { swap "$STATE/phoenix-side" "$STATE/user-side"; echo no > "$STATE/active"; }
    rm -rf "$STATE/phoenix-side"
    local n_removed=0 n_restored=0 rel
    while IFS= read -r rel; do                       # files Phoenix added: removed
        [ -n "$rel" ] && [ -e "$HOME/$rel" ] && rm -f "$HOME/$rel" && n_removed=$((n_removed + 1))
    done < "$STATE/added-files.txt"
    if [ -d "$STATE/backup" ]; then                  # files Phoenix replaced: their originals back
        while IFS= read -r -d '' f; do
            rel="${f#"$STATE/backup/"}"
            mkdir -p "$(dirname "$HOME/$rel")"; cp -a "$f" "$HOME/$rel"; n_restored=$((n_restored + 1))
        done < <(find "$STATE/backup" -type f -print0)
    fi
    if [ "$(cat "$STATE/cloned-end4pC" 2>/dev/null)" = yes ]; then
        rm -rf "$HOME/.config/quickshell/end4-pC"
    fi
    rm -rf "$HOME/.local/state/custom-fixes" "$HOME/.local/share/custom-fixes" "$HOME/.local/state/setup-wizard" \
           "$HOME/.local/state/setup-profiles" "$HOME/hypr-guard" "$HOME"/hypr-known-good-* "$HOME/.hypr-known-good-latest"
    local keep="$HOME/.local/state/phoenix-uninstalled-$(date +%Y%m%d-%H%M%S)"
    mv "$STATE" "$keep"
    echo "Phoenix removed: $n_removed file(s) removed, $n_restored restored. A copy of the backups stays in $keep."
    restart_shell "$(qs_config_of_ii)"
    rm -f "$HOME/.local/bin/phoenix"
}

# The service runs as root, so it runs root-owned copies, never the files in this home folder (any program running as
# the user could change those).
METER_SRC="$HOME/.local/share/phoenix/system"
METER_BIN=/usr/local/libexec/phoenix-power-meter
METER_UNIT=/etc/systemd/system/phoenix-power-meter.service
cmd_power_meter() {
    case "${1:-status}" in
        install)
            [ -f "$METER_SRC/phoenix-power-meter" ] && [ -f "$METER_SRC/phoenix-power-meter.service" ] \
                || die "the power meter files are missing in $METER_SRC (update Phoenix first)"
            echo "Installing the CPU power meter (asks for your password)."
            sudo install -D -m 755 -o root -g root "$METER_SRC/phoenix-power-meter" "$METER_BIN" \
                && sudo install -D -m 644 -o root -g root "$METER_SRC/phoenix-power-meter.service" "$METER_UNIT" \
                && sudo systemctl daemon-reload && sudo systemctl enable --now phoenix-power-meter.service \
                || die "installing the power meter failed"
            echo "Done: CPU power shows in the system stats within a few seconds." ;;
        remove)
            [ -f "$METER_UNIT" ] || [ -f "$METER_BIN" ] || { echo "The power meter isn't installed."; return; }
            sudo systemctl disable --now phoenix-power-meter.service 2>/dev/null
            sudo rm -f "$METER_UNIT" "$METER_BIN" && sudo systemctl daemon-reload
            echo "Power meter removed." ;;
        status)
            if systemctl is-active -q phoenix-power-meter.service; then
                echo "Power meter: running ($(cat /run/phoenix-power/cpu.json 2>/dev/null))"
            elif [ -f "$METER_UNIT" ]; then echo "Power meter: installed, not running (systemctl status phoenix-power-meter)"
            else echo "Power meter: not installed (phoenix power-meter install)"; fi ;;
        *) die "usage: phoenix power-meter [install|remove|status]" ;;
    esac
}

# Login screen (P5, 2026-10-08): greetd runs the Phoenix greeter (Quickshell inside the cage compositor) on tty1
# instead of signing in automatically. The greeter and the session starter are root-owned copies; the theme folder
# belongs to the main user so phoenix-greeter-theme can refresh it at each login without sudo. What install changed
# (tty1 autologin, another display manager, an existing greetd config) is kept in /etc/phoenix-login-screen/ and
# put back by remove.
GREETER_SRC="$HOME/.local/share/phoenix/greeter"
GREETER_DIR=/usr/share/phoenix-greeter
LS_SAVE=/etc/phoenix-login-screen
GETTY_D=/etc/systemd/system/getty@tty1.service.d   # tty1 autologin drop-ins (Phoenix's installer: ovveride.conf)
autologin_files() { grep -l -- "--autologin" "$GETTY_D"/*.conf 2>/dev/null; }
cmd_login_screen() {
    case "${1:-status}" in
        install)
            [ -f "$GREETER_SRC/greeter.qml" ] && [ -f "$GREETER_SRC/phoenix-session" ] \
                || die "the login screen files are missing in $GREETER_SRC (update Phoenix first)"
            echo "Installing the Phoenix login screen (asks for your password)."
            sudo pacman -S --needed --noconfirm greetd cage || die "installing greetd and cage failed"
            sudo install -D -m 644 -o root -g root "$GREETER_SRC/greeter.qml" "$GREETER_DIR/greeter.qml" \
                && sudo install -D -m 755 -o root -g root "$GREETER_SRC/phoenix-session" /usr/local/bin/phoenix-session \
                || die "copying the login screen failed"
            # the font the login screen uses, also for the greeter user (Phoenix installs it for you only)
            local font="$HOME/.local/share/fonts/illogical-impulse-google-sans-flex"
            if [ -d "$font" ]; then
                sudo mkdir -p /usr/local/share/fonts/phoenix-greeter && sudo cp -r "$font"/. /usr/local/share/fonts/phoenix-greeter/ \
                    && sudo fc-cache -f /usr/local/share/fonts/phoenix-greeter >/dev/null
            fi
            sudo install -d -m 755 -o "$USER" -g "$(id -gn)" /var/lib/phoenix-greeter/theme
            sudo install -d -m 755 -o greeter -g greeter /var/lib/phoenix-greeter/state
            sudo mkdir -p "$LS_SAVE"
            # what was there before, once (a second install doesn't overwrite the first backup)
            if [ -f /etc/greetd/config.toml ] && [ ! -f "$LS_SAVE/config.toml" ]; then sudo cp -a /etc/greetd/config.toml "$LS_SAVE/config.toml"; fi
            local f
            for f in $(autologin_files); do sudo mkdir -p "$LS_SAVE/getty" && sudo mv "$f" "$LS_SAVE/getty/"; done
            local dm; dm=$(basename "$(readlink /etc/systemd/system/display-manager.service 2>/dev/null)" 2>/dev/null)
            if [ -n "$dm" ] && [ "$dm" != "greetd.service" ]; then
                echo "$dm" | sudo tee "$LS_SAVE/display-manager" >/dev/null
                sudo systemctl disable "$dm"
            fi
            printf '%s\n' "# Written by \`phoenix login-screen install\` (the Phoenix login screen). \`phoenix login-screen remove\` puts back what was here." \
                "[terminal]" "vt = 1" "" "[default_session]" \
                "command = \"env QT_WAYLAND_DISABLE_WINDOWDECORATION=1 cage -s -m last -- qs -p $GREETER_DIR/greeter.qml\"" "user = \"greeter\"" \
                | sudo tee /etc/greetd/config.toml >/dev/null
            sudo systemctl enable greetd.service || die "enabling the login screen failed"
            "$HOME/.local/bin/phoenix-greeter-theme" 2>/dev/null
            echo "Done: the login screen appears the next time the PC starts." ;;
        remove)
            [ -f "$GREETER_DIR/greeter.qml" ] || [ -d "$LS_SAVE" ] || { echo "The login screen isn't installed."; return; }
            echo "Removing the Phoenix login screen (asks for your password)."
            sudo systemctl disable greetd.service 2>/dev/null
            if [ -d "$LS_SAVE/getty" ]; then sudo mkdir -p "$GETTY_D" && sudo cp -a "$LS_SAVE/getty/." "$GETTY_D/"; fi
            if [ -f "$LS_SAVE/display-manager" ]; then sudo systemctl enable "$(cat "$LS_SAVE/display-manager")"; fi
            if [ -f "$LS_SAVE/config.toml" ]; then sudo cp -a "$LS_SAVE/config.toml" /etc/greetd/config.toml; else sudo rm -f /etc/greetd/config.toml; fi
            sudo rm -rf "${GREETER_DIR:?}" /var/lib/phoenix-greeter /usr/local/share/fonts/phoenix-greeter "${LS_SAVE:?}"
            sudo rm -f /usr/local/bin/phoenix-session
            sudo systemctl daemon-reload
            echo "Removed: the PC signs in the way it did before, from the next start (greetd and cage stay installed)." ;;
        status)
            if systemctl is-enabled -q greetd.service 2>/dev/null && grep -q "$GREETER_DIR" /etc/greetd/config.toml 2>/dev/null; then
                echo "Login screen: on (asks for the password at startup)"
            elif [ -n "$(autologin_files)" ]; then echo "Login screen: off (signs in automatically)"
            else echo "Login screen: off"; fi ;;
        *) die "usage: phoenix login-screen [install|remove|status]" ;;
    esac
}

case "${1:-status}" in
    status) cmd_status ;;
    activate) cmd_activate ;;
    deactivate) cmd_deactivate ;;
    uninstall) cmd_uninstall "${2:-}" ;;
    power-meter) cmd_power_meter "${2:-status}" ;;
    login-screen) cmd_login_screen "${2:-status}" ;;
    *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
