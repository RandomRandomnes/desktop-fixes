#!/usr/bin/env python3
"""hypr-guard: keeps the desktop customizations alive across dotfiles updates.

  hypr-guard check      reconcile files with the snapshot, verify the shell, write a report,
                        notify only if something needs attention (runs automatically at login)
  hypr-guard doctor     read-only: just write the report (~/hypr-guard/report.md)
  hypr-guard update     safely pull the latest end4-pC shell, then run check
  hypr-guard snapshot   save the current (working) state as the new known-good snapshot
  hypr-guard restore    force every tracked file back to the snapshot (merging where upstream moved)

This file holds the ONE list of tracked files (MANIFEST). Everything else calls this tool.

How reconciling works for files inside the end4-pC git repo: the snapshot keeps our customized copy
plus the upstream version it was built on ("base"). If an update changes upstream, our changes are
3-way merged onto the new upstream (git merge-file) instead of overwriting it with a stale copy.
Merges are verified against the live shell log and rolled back if they break the shell.
Files outside the repo (hypr custom/) are only restored if missing; edits there are reported, not undone.
"""
import json, os, re, shutil, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
# The HYPR_GUARD_* overrides exist only so the update/merge logic can be tested on a scratch copy.
QS = os.environ.get("HYPR_GUARD_QS", f"{HOME}/.config/quickshell/end4-pC")
HC = os.environ.get("HYPR_GUARD_HC", f"{HOME}/.config/hypr/custom")
STATE = os.environ.get("HYPR_GUARD_STATE", f"{HOME}/hypr-guard")
SNAPROOT = os.environ.get("HYPR_GUARD_SNAPROOT", HOME)
POINTER = f"{SNAPROOT}/.hypr-known-good-latest"
KEEP_SNAPSHOTS = 3
KEEP_BACKUPS = 20
QS_INSTANCE = "^qs -c end4-pC$"

# name -> live path. Names are the file names inside the snapshot folder.
MANIFEST = {
    # Hyprland custom config (not in a git repo)
    "env.lua": f"{HC}/env.lua",   # feature-switch loader (2026-10-03)
    "rules.lua": f"{HC}/rules.lua",
    "general.lua": f"{HC}/general.lua",
    "execs.lua": f"{HC}/execs.lua",
    "keybinds.lua": f"{HC}/keybinds.lua",
    "hb.sh": f"{HC}/scripts/hb.sh",
    "autostart.sh": f"{HC}/scripts/autostart.sh",
    # Shell: app grid, widgets-behind-wallpaper fix, network fix
    "AppGridWidget.qml": f"{QS}/modules/ii/overview/AppGridWidget.qml",
    "Overview.qml": f"{QS}/modules/ii/overview/Overview.qml",
    "Background.qml": f"{QS}/modules/ii/background/Background.qml",
    "GlobalStates.qml": f"{QS}/GlobalStates.qml",
    # Shell: Wallpaper Engine drawn inside the background surface (file is ours; Background.qml loads it)
    "WallpaperEngineLayer.qml": f"{QS}/modules/ii/background/WallpaperEngineLayer.qml",
    "IllogicalImpulseFamily.qml": f"{QS}/panelFamilies/IllogicalImpulseFamily.qml",
    "Network.qml": f"{QS}/services/Network.qml",
    # Shell: Hyprland <-> Plasma switch button
    "SidebarRightContent.qml": f"{QS}/modules/ii/sidebarRight/SidebarRightContent.qml",
    "DesktopSwitch.qml": f"{QS}/modules/ii/sidebarRight/quickToggles/classicStyle/DesktopSwitch.qml",
    "DeviceBatteries.qml": f"{QS}/modules/ii/sidebarRight/DeviceBatteries.qml",
    # Shell: Wallpaper Engine picker card in the right sidebar (file is ours; SidebarRightContent.qml loads it)
    "WallpaperEngineCard.qml": f"{QS}/modules/ii/sidebarRight/WallpaperEngineCard.qml",
    # Shell: power menu Hibernate button replaced by "Switch to KDE"
    "SessionScreen.qml": f"{QS}/modules/ii/sessionScreen/SessionScreen.qml",
    # Shell: Claude Code as a model in the AI sidebar (strategy file is ours, Ai.qml registers it)
    "Ai.qml": f"{QS}/services/Ai.qml",
    "ClaudeCodeApiStrategy.qml": f"{QS}/services/ai/ClaudeCodeApiStrategy.qml",
    # Shell: GPU / GPU-power widget (previously only ~/reapply-gpu-widget.sh)
    "Resources.qml": f"{QS}/modules/ii/bar/Resources.qml",
    "ResourcesPopup.qml": f"{QS}/modules/ii/bar/ResourcesPopup.qml",
    # Shell: custom-feature switches (2026-10-03): Settings › Extras, setup profiles (files ours)
    "Extras.qml": f"{QS}/services/Extras.qml",
    "FirstRunExperience.qml": f"{QS}/services/FirstRunExperience.qml",   # welcome.qml replaced by setup-wizard.qml
    "setup-wizard.qml": f"{QS}/setup-wizard.qml",   # first-time setup wizard (2026-10-03)
    "quick-start.qml": f"{QS}/quick-start.qml",     # Quick Start guide app (2026-10-03)
    "ResourcesPopupClassic.qml": f"{QS}/modules/ii/bar/ResourcesPopupClassic.qml",
    "ResourceUsage.qml": f"{QS}/services/ResourceUsage.qml",
    "BarConfig.qml": f"{QS}/modules/ii/settings/pages/BarConfig.qml",
    "Config.qml": f"{QS}/modules/common/Config.qml",
    "get_gpuinfo.sh": f"{QS}/scripts/gpu/get_gpuinfo.sh",
    "gpustats.py": f"{QS}/scripts/gpu/gpustats.py",   # AMD / NVIDIA / Intel stats for both resource widgets
    "get_power.sh": f"{QS}/scripts/power/get_power.sh",
    # Shell: bar resources widget redo (2026-10-03): live CPU/GPU/RAM graphs + detailed popup (all three files ours)
    "ResourceGraph.qml": f"{QS}/modules/ii/bar/ResourceGraph.qml",
    "SystemStats.qml": f"{QS}/services/SystemStats.qml",
    "sysstats.py": f"{QS}/scripts/sysstats/sysstats.py",
    # Shell: bar update button runs ~/.local/bin/system-update; count includes pending shell updates
    "UpdatesCount.qml": f"{QS}/modules/ii/bar/UpdatesCount.qml",
    "Updates.qml": f"{QS}/services/Updates.qml",
    # Shell: Windows 11 style settings (whole folder is ours; IllogicalImpulseFamily.qml loads W11Settings)
    **{f"settingsW11__{n}": f"{QS}/modules/ii/settingsW11/{n}" for n in [
        "W11Settings.qml", "WState.qml", "WCard.qml", "WToggle.qml", "WCombo.qml", "WSlider.qml", "WLink.qml",
        "WSection.qml", "WButton.qml", "WPage.qml", "WTile.qml", "WAppListEditor.qml", "defaultapps.py",
        "PHome.qml", "PSystem.qml", "PDevices.qml", "PNetwork.qml", "PPersonalization.qml", "PApps.qml",
        "PAccounts.qml", "PTime.qml", "PGaming.qml", "PAccessibility.qml", "PPrivacy.qml", "PUpdate.qml", "PExtras.qml"]},
}

# Shell log lines that are known, pre-existing and harmless (see HANDOFF.md §11).
HARMLESS = [
    r'read-only property "mirrored"', r"translations/en_US\.json", r"wallpaper_order\.json",
    r"Cannot open: file://.*/\.face", r"qt\.qml\.propertyCache", r"sni\.item",
    r"Failed to register with host portal", r"UtilButton\.qml\[23:13\]",
    # Upstream Network.qml (lines not customized): null entries while the wifi list refreshes. Cosmetic.
    r"Network\.qml\[\d+:-1\]: TypeError: Cannot read property '(active|frequency)' of null",
    # Upstream AI sidebar (enabled 2026-10-02): message delegates read messageData before it is set, once per
    # message when the Intelligence tab loads. Cosmetic.
    r"StringUtils\.qml\[92:-1\]: TypeError: Cannot read property 'length' of undefined",
    r"AiMessage\.qml\[259:13\]: Unable to assign \[undefined\] to bool",
    r"MessageTextBlock\.qml\[132:17\]: Unable to assign \[undefined\] to QObject\*",
    r"ai/chats/lastSession\.json failed: File does not exist",
]
HARD_ERROR = re.compile(r"\bERROR\b|Failed to load configuration|is not a type|SyntaxError|"
                        r"ReferenceError|TypeError|Cannot assign to non-existent|Expected token")
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def run(cmd, **kw):
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    try:
        return subprocess.run(cmd, **kw)
    except FileNotFoundError as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except (FileNotFoundError, IsADirectoryError):
        return None


def write(path, text, mode=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)
    if mode is not None:
        os.chmod(path, mode)


def rel_in_repo(path):
    return os.path.relpath(path, QS) if path.startswith(QS + "/") else None


def git(*args):
    return run(["git", "-C", QS, *args])


def git_head():
    r = git("rev-parse", "HEAD")
    return r.stdout.strip() if r.returncode == 0 else None


def upstream_version(rel):
    """The file as committed at the repo's current HEAD, or None if git doesn't track it."""
    r = git("show", f"HEAD:{rel}")
    return r.stdout if r.returncode == 0 else None


def merge3(ours, base, theirs):
    """Apply our snapshot changes (base->ours) onto the new upstream (theirs). Returns (text, conflicts)."""
    with tempfile.TemporaryDirectory() as d:
        paths = []
        for n, t in (("ours", ours), ("base", base), ("theirs", theirs)):
            p = os.path.join(d, n)
            write(p, t)
            paths.append(p)
        r = run(["git", "merge-file", "-p", "-L", "snapshot (your customizations)", "-L", "old upstream",
                 "-L", "new upstream", *paths])
        if r.returncode < 0 or r.returncode > 127:
            return None, -1
        return r.stdout, r.returncode


def snapshot_dir():
    snap = (read(POINTER) or "").strip()
    return snap if snap and os.path.isdir(snap) else None


def load_meta(snap):
    try:
        return json.loads(read(f"{snap}/meta.json") or "{}")
    except json.JSONDecodeError:
        return {}


def pkg_versions():
    r = run(["pacman", "-Q", "hyprland", "aquamarine", "hyprland-plugin-hyprbars",
             "illogical-impulse-quickshell-git", "plasma-workspace"])
    out = {}
    for line in (r.stdout + r.stderr).splitlines():
        parts = line.split()
        if len(parts) == 2:
            out[parts[0]] = parts[1]
    return out


def qs_instances():
    r = run(["pgrep", "-f", QS_INSTANCE])
    return len(r.stdout.split())


def qs_log_lines():
    r = run(["qs", "log", "-c", "end4-pC"])
    return [ANSI.sub("", l) for l in (r.stdout + r.stderr).splitlines()]


def current_log_lines():
    """Log lines since the shell's last config (re)load, so errors from older reloads don't count."""
    lines = qs_log_lines()
    last = max((i for i, l in enumerate(lines) if "Configuration Loaded" in l or
                "Failed to load configuration" in l), default=0)
    return lines[last:]


def classify_log(lines):
    hard, other, harmless = [], [], 0
    for l in lines:
        if not re.search(r"\b(WARN|ERROR|FATAL)\b", l):
            continue
        if any(re.search(h, l) for h in HARMLESS):
            harmless += 1
        elif HARD_ERROR.search(l):
            hard.append(l.strip())
        else:
            other.append(l.strip())
    dedup = lambda xs: list(dict.fromkeys(xs))
    return dedup(hard), dedup(other), harmless


def notify(summary, body, urgency="normal"):
    run(["notify-send", "-a", "Desktop check", "-u", urgency, "-i", "dialog-warning"
         if urgency == "critical" else "dialog-information", summary, body])


class Run:
    def __init__(self, mode):
        self.mode = mode
        self.ts = time.strftime("%Y%m%d-%H%M%S")
        self.actions, self.problems, self.notes = [], [], []
        self.file_status = {}
        self.written = {}  # name -> previous content (None = didn't exist)
        self.merged = {}   # name -> (merged_text, theirs) for clean merges to verify
        os.makedirs(f"{STATE}/reports", exist_ok=True)
        self.log = open(f"{STATE}/guard.log", "a")
        self.say(f"=== {mode} started ===")

    def say(self, msg):
        self.log.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")
        self.log.flush()
        if sys.stdout.isatty():
            print(msg)

    def backup(self, name, path):
        d = f"{STATE}/backups/{self.ts}"
        os.makedirs(d, exist_ok=True)
        if os.path.exists(path):
            shutil.copy2(path, f"{d}/{name}")

    def put(self, name, path, text, mode):
        self.backup(name, path)
        self.written.setdefault(name, read(path))
        write(path, text, mode)

    # ---------- reconcile ----------
    def reconcile(self, force=False):
        self.log_start = len(qs_log_lines())
        snap = snapshot_dir()
        if not snap:
            self.no_snapshot = True
            self.problems.append("No snapshot found (~/.hypr-known-good-latest). Run `hypr-guard snapshot` "
                                 "once the desktop is confirmed working.")
            return
        head = git_head()
        for name, path in MANIFEST.items():
            src = f"{snap}/{name}"
            ours = read(src)
            if ours is None:
                self.file_status[name] = "not in snapshot"
                continue
            mode = os.stat(src).st_mode & 0o777
            live = read(path)
            rel = rel_in_repo(path)
            if live == ours:
                self.file_status[name] = "ok"
                continue
            if rel is None:  # hypr custom/ file, outside any repo
                if live is None or force:
                    self.put(name, path, ours, mode)
                    self.file_status[name] = "restored"
                    self.actions.append(f"{name}: restored from snapshot ({'missing' if live is None else 'forced'}).")
                else:
                    self.file_status[name] = "edited since snapshot (left alone)"
                    self.notes.append(f"{name} differs from the snapshot. Left alone because updates don't touch "
                                      f"hypr custom/. If the edit is intended and working, run `hypr-guard snapshot`.")
                continue

            base = read(f"{snap}/base/{name}")
            theirs = upstream_version(rel)
            conflicted = live is not None and re.search(r"^<<<<<<< ", live, re.M)
            reverted = live is None or conflicted or (theirs is not None and live == theirs)
            if not reverted and not force:
                self.file_status[name] = "edited since snapshot (left alone)"
                self.notes.append(f"{name} has local edits that aren't in the snapshot and isn't an upstream "
                                  f"revert. Left alone. If the edit is intended and working, run `hypr-guard snapshot`.")
                continue
            if theirs is None or base is None or theirs == base:
                # Upstream didn't change this file (or it's our own new file): the snapshot copy is still right.
                if theirs is not None and base is None:
                    self.problems.append(f"{name}: upstream now ships its own {rel}, but the snapshot has no base "
                                         f"for it. Restored our copy. Check it still fits.")
                self.put(name, path, ours, mode)
                self.file_status[name] = "restored"
                self.actions.append(f"{name}: restored from snapshot (customization was missing).")
                continue
            # Upstream changed this file since the snapshot: merge instead of overwriting.
            merged, conflicts = merge3(ours, base, theirs)
            cdir = f"{STATE}/conflicts"
            if conflicts == 0 and merged is not None:
                self.put(name, path, merged, mode)
                self.merged[name] = (merged, theirs)
                self.file_status[name] = "merged onto new upstream"
                self.actions.append(f"{name}: upstream changed it; merged your customizations onto the new version.")
            else:
                os.makedirs(cdir, exist_ok=True)
                if merged:
                    write(f"{cdir}/{name}.merge", merged)
                write(f"{cdir}/{name}.ours", ours)
                write(f"{cdir}/{name}.base", base)
                write(f"{cdir}/{name}.theirs", theirs)
                self.put(name, path, theirs, mode)
                self.file_status[name] = "CONFLICT (running plain upstream version)"
                self.problems.append(f"{name}: upstream changed the same lines as your customization "
                                     f"({conflicts} conflict(s)). Using the plain upstream file for now, so this "
                                     f"customization is missing. Merge attempt saved in ~/hypr-guard/conflicts/.")
        if head and snap:
            self.notes.append(f"end4-pC HEAD {head[:9]}, snapshot built on {load_meta(snap).get('end4_head', '?')[:9]}.")

    # ---------- verify ----------
    def verify(self, wait):
        if not self.written:
            return
        self.say("verifying shell after writes")
        deadline = time.time() + wait
        while time.time() < deadline and qs_instances() == 0:
            time.sleep(1)
        if qs_instances() == 0:
            self.rollback(list(self.written), "the shell is not running after the changes")
            self.relaunch_shell()
            return
        # Wait until Quickshell has finished reloading after our writes (no reload event for 4s).
        new, quiet_since, last_len = [], time.time(), -1
        while time.time() < deadline:
            new = qs_log_lines()[self.log_start:]
            if len(new) != last_len:
                last_len, quiet_since = len(new), time.time()
            outcomes = [l for l in new if "Configuration Loaded" in l or "Failed to load configuration" in l]
            if outcomes and time.time() - quiet_since > 4:
                break
            time.sleep(1)
        # Only the LAST reload counts (earlier ones can fail mid-update while files are still being written).
        last = max((i for i, l in enumerate(new) if "Configuration Loaded" in l or
                    "Failed to load configuration" in l), default=None)
        bad = []
        if last is not None and "Failed to load configuration" in new[last]:
            chain = [l for l in new[last:] if "caused by @" in l][:20]
            root = re.search(r"caused by @([^\[]+)\[", chain[-1]) if chain else None
            culprit = root.group(1) if root else None
            bad = [n for n in self.written if rel_in_repo(MANIFEST[n]) == culprit]
            if not bad:
                self.problems.append(f"The shell failed to load, but the root cause is `{culprit}`, which "
                                     f"hypr-guard didn't write (upstream problem or half-finished update). "
                                     f"Nothing rolled back. See Shell log.")
        else:
            hard, _, _ = classify_log(new[last:] if last is not None else new)
            bad = [n for n in self.written if any(f"@{rel_in_repo(MANIFEST[n]) or '-'}[" in l for l in hard)]
        if bad:
            self.rollback(bad, "the shell logged errors in them right after")
        # Clean, verified merges become the new snapshot entry so they aren't redone every login.
        snap = snapshot_dir()
        for name, (merged, theirs) in self.merged.items():
            if name in bad or not snap:
                continue
            write(f"{snap}/{name}", merged)
            write(f"{snap}/base/{name}", theirs)
            self.actions.append(f"{name}: merge verified, snapshot updated to the merged version.")

    def rollback(self, names, why):
        for n in names:
            prev = self.written.get(n)
            path = MANIFEST[n]
            rel = rel_in_repo(path)
            theirs = upstream_version(rel) if rel else None
            # Prefer the plain upstream file (known to load) over whatever was there before.
            fallback = theirs if theirs is not None else prev
            if fallback is None:
                if os.path.exists(path):
                    os.remove(path)
            else:
                write(path, fallback)
            self.merged.pop(n, None)
            self.file_status[n] = "ROLLED BACK (customization missing)"
            self.problems.append(f"{n}: rolled back because {why}. The customization is currently missing.")

    def relaunch_shell(self):
        subprocess.Popen(["setsid", "qs", "-c", "end4-pC"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        self.actions.append("Relaunched the shell.")

    # ---------- report ----------
    def environment_checks(self):
        r = run(["hyprctl", "configerrors"])
        errs = r.stdout.strip()
        if r.returncode == 0 and errs:
            self.problems.append("Hyprland config errors:\n```\n" + errs + "\n```")
        p = run(["hyprctl", "plugin", "list"])
        if p.returncode == 0 and "hyprbars" not in p.stdout:
            self.problems.append("Title bar plugin (hyprbars) isn't loaded. Usually Hyprland was updated and the "
                                 "plugin must be rebuilt to match: `yay -S hyprland-plugin-hyprbars`, then log out/in.")
        n = qs_instances()
        if n != 1:
            self.problems.append(f"Shell instances running: {n} (expected 1). "
                                 + ("Bars are stacking." if n > 1 else "The shell isn't running."))
        return errs, p.stdout

    def report(self):
        snap = snapshot_dir()
        meta = load_meta(snap) if snap else {}
        configerrors, plugins = self.environment_checks()
        hard, other, harmless = classify_log(current_log_lines())
        if hard:
            self.problems.append(f"Shell logged {len(hard)} unexpected error line(s), listed under Shell log.")
        now = pkg_versions()
        then = meta.get("packages", {})
        changed_pkgs = {k: (then.get(k), v) for k, v in now.items() if then.get(k) != v}
        git_status = git("status", "--short").stdout
        tracked = {rel_in_repo(p) for p in MANIFEST.values()}
        untracked_mods = [l for l in git_status.splitlines()
                          if l[:2].strip() in ("M", "MM", "AM", "UU") and l[3:] not in tracked]
        if untracked_mods:
            self.notes.append("end4-pC files modified but NOT tracked by hypr-guard (an update would lose them): "
                              + ", ".join(l[3:] for l in untracked_mods))
        cores = run(["coredumpctl", "list", "--since", "-3h", "--no-pager", "--no-legend"]).stdout.strip()

        L = []
        status = "OK" if not self.problems else f"{len(self.problems)} PROBLEM(S)"
        L += [f"# Desktop check: {status}", "",
              f"Run: `{self.mode}` at {time.strftime('%Y-%m-%d %H:%M:%S')}. Snapshot: `{snap}`.", "",
              "> For Claude Code: this is the first thing to read when the desktop misbehaves after an update.",
              "> Merge leftovers are in ~/hypr-guard/conflicts/ (`.ours` = customized copy, `.base` = old upstream,",
              "> `.theirs` = new upstream, `.merge` = merge with conflict markers). Pre-change copies of every",
              "> file this tool wrote are in ~/hypr-guard/backups/<timestamp>/. Full history: ~/hypr-guard/guard.log.",
              "> After fixing a file and confirming the shell is clean, run `hypr-guard snapshot`.", ""]
        L += ["## Problems", ""] + ([f"- {p}" for p in self.problems] or ["None."]) + [""]
        L += ["## Actions taken this run", ""] + ([f"- {a}" for a in self.actions] or ["None."]) + [""]
        if self.notes:
            L += ["## Notes", ""] + [f"- {n}" for n in self.notes] + [""]
        if self.file_status:
            L += ["## Tracked files", "", "| file | status |", "|---|---|"]
            L += [f"| {n} | {s} |" for n, s in self.file_status.items()] + [""]
        L += ["## Versions (snapshot → now)", ""]
        L += [f"- {k}: {then.get(k, '?')} → {v}{'  **changed**' if k in changed_pkgs else ''}" for k, v in now.items()]
        L += [f"- end4-pC HEAD: {meta.get('end4_head', '?')[:9]} → {(git_head() or '?')[:9]}", ""]
        L += ["## Hyprland", "", "configerrors: " + (configerrors or "none"), "", "```", plugins.strip(), "```", ""]
        L += ["## Shell log", "", f"Instances: {qs_instances()}. Known-harmless lines skipped: {harmless}.", ""]
        L += ["Unexpected errors:", "```"] + (hard[-40:] or ["none"]) + ["```", ""]
        L += ["Other warnings (usually fine):", "```"] + (other[-25:] or ["none"]) + ["```", ""]
        L += ["## end4-pC git status", "```", git_status.strip() or "clean", "```", ""]
        L += ["## Crashes (last 3h)", "```", cores or "none", "```", ""]
        L += ["## Desktop switch", "", f"~/.config/desktop-session = {(read(HOME + '/.config/desktop-session') or 'missing').strip()}", ""]
        auto = read(HOME + "/hypr-autostart.log") or ""
        L += ["## Autostart log (tail)", "```"] + auto.splitlines()[-12:] + ["```", ""]

        text = "\n".join(L)
        write(f"{STATE}/report.md", text)
        write(f"{STATE}/reports/{self.ts}-{self.mode}.md", text)
        reports = sorted(os.listdir(f"{STATE}/reports"))
        for old in reports[:-30]:
            os.remove(f"{STATE}/reports/{old}")
        backups = sorted(os.listdir(f"{STATE}/backups")) if os.path.isdir(f"{STATE}/backups") else []
        for old in backups[:-KEEP_BACKUPS]:
            shutil.rmtree(f"{STATE}/backups/{old}", ignore_errors=True)
        self.say(f"report: {status}; actions: {len(self.actions)}")
        self.say(f"=== {self.mode} finished ===")
        return text


# ---------- commands ----------
def cmd_check(args):
    at_login = "--login" in args
    r = Run("check")
    r.reconcile()
    if any(MANIFEST[n].startswith(HC) for n in r.written):
        run(["hyprctl", "reload"])
    r.verify(wait=40 if at_login else 12)
    if at_login:  # let the shell and autostart finish starting so the report isn't a false alarm
        for _ in range(40):
            if qs_instances():
                break
            time.sleep(1)
        time.sleep(20)
    # A fresh install has no snapshot yet: if that is the only finding, the desktop that just started is the
    # known-good state, so take the first snapshot instead of raising an alarm.
    if at_login and getattr(r, "no_snapshot", False) and len(r.problems) == 1:
        if cmd_snapshot([]) == 0:
            r.problems.clear()
            r.say("first snapshot taken at login (fresh install)")
    r.report()
    if "--no-notify" not in args:
        if r.problems:
            notify(f"Desktop check: {len(r.problems)} problem(s)",
                   "The desktop needs attention after a change or update. Details: ~/hypr-guard/report.md",
                   "critical")
        elif r.actions:
            notify("Desktop check: customizations reapplied",
                   f"{len(r.actions)} file(s) fixed after an update. Nothing to do.")
    print(f"{'OK' if not r.problems else str(len(r.problems)) + ' problem(s)'}. Report: {STATE}/report.md")
    return 1 if r.problems else 0


def cmd_doctor(args):
    r = Run("doctor")
    snap = snapshot_dir()
    if snap:
        for name, path in MANIFEST.items():
            ours = read(f"{snap}/{name}")
            r.file_status[name] = ("not in snapshot" if ours is None else
                                   "ok" if read(path) == ours else "differs from snapshot")
    r.report()
    print(f"{'OK' if not r.problems else str(len(r.problems)) + ' problem(s)'}. Report: {STATE}/report.md")
    return 1 if r.problems else 0


def cmd_restore(args):
    r = Run("restore")
    r.reconcile(force=True)
    run(["hyprctl", "reload"])
    r.verify(wait=12)
    r.report()
    print("\n".join(r.actions) or "Everything already matched the snapshot.")
    print(f"Report: {STATE}/report.md")
    return 1 if r.problems else 0


def cmd_snapshot(args):
    hard, _, _ = classify_log(current_log_lines())
    errs = run(["hyprctl", "configerrors"]).stdout.strip()
    if (hard or errs or qs_instances() != 1) and "--force" not in args:
        print("Refusing to snapshot: the desktop doesn't look healthy right now.")
        for l in ([errs] if errs else []) + hard[-10:]:
            print("  " + l)
        print(f"Shell instances: {qs_instances()}. Use --force to snapshot anyway.")
        return 1
    snap = f"{SNAPROOT}/hypr-known-good-{time.strftime('%Y%m%d-%H%M%S')}"
    os.makedirs(f"{snap}/base")
    for name, path in MANIFEST.items():
        if not os.path.exists(path):
            print(f"Missing, not snapshotted: {name}")
            continue
        shutil.copy2(path, f"{snap}/{name}")
        rel = rel_in_repo(path)
        base = upstream_version(rel) if rel else None
        if base is not None:
            write(f"{snap}/base/{name}", base)
    meta = {"created": time.strftime("%Y-%m-%d %H:%M:%S"), "end4_head": git_head(), "packages": pkg_versions()}
    write(f"{snap}/meta.json", json.dumps(meta, indent=2))
    write(POINTER, snap + "\n")
    print(f"Snapshot saved: {snap} ({len(os.listdir(snap)) - 2} files)")
    snaps = sorted(d for d in os.listdir(SNAPROOT) if d.startswith("hypr-known-good-2"))
    for old in snaps[:-KEEP_SNAPSHOTS]:
        shutil.rmtree(f"{SNAPROOT}/{old}")
        print(f"Pruned old snapshot: {old}")
    return 0


def cmd_update(args):
    print("Fetching end4-pC...")
    if git("fetch").returncode != 0:
        print("git fetch failed (offline?). Nothing changed.")
        return 1
    behind = git("rev-list", "--count", "HEAD..@{u}").stdout.strip()
    if behind == "0":
        print("end4-pC is already up to date.")
        return cmd_check(args)
    if git("diff", "--name-only", "--diff-filter=U").stdout.strip():
        print("The repo is in the middle of a merge (unmerged files). Not touching it. Run `hypr-guard doctor`.")
        return 1
    snap = snapshot_dir()
    modified = git("diff", "--name-only", "HEAD").stdout.split()
    by_rel = {rel_in_repo(p): n for n, p in MANIFEST.items() if rel_in_repo(p)}
    unsafe = [m for m in modified
              if m not in by_rel or not snap or read(f"{QS}/{m}") != read(f"{snap}/{by_rel[m]}")]
    if unsafe:
        print("These files have changes that aren't saved in the snapshot, so pulling could lose them:")
        print("  " + "\n  ".join(unsafe))
        print("Snapshot them first (`hypr-guard snapshot`) if they're intended, then rerun update.")
        return 1
    print(f"{behind} new upstream commit(s). Customized files are safe in the snapshot; resetting them for the pull.")
    if modified:
        git("checkout", "--", *modified)
    pull = git("pull", "--ff-only")
    print(pull.stdout + pull.stderr)
    if pull.returncode != 0:
        print("Pull failed; putting your customizations back.")
    return cmd_check(args)


def main():
    cmds = {"check": cmd_check, "doctor": cmd_doctor, "restore": cmd_restore,
            "snapshot": cmd_snapshot, "update": cmd_update}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(__doc__)
        return 2
    os.makedirs(STATE, exist_ok=True)
    return cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
