#!/usr/bin/env python3
"""Restore points (2026-10-08, ours). Made by system-update before every update; Settings › Update › Restore points.

  restore-point create [--reason TEXT]    save one now (prints its id)
  restore-point list                      JSON, newest first: id, date, reason, changes since (packages, shell, fixes)
  restore-point restore <id> [--yes]      go back to it: desktop settings now, old package versions in a terminal

A restore point holds:
  - the installed package versions (pacman -Q)
  - the desktop settings: ~/.config/hypr, ~/.config/illogical-impulse and the shell (~/.config/quickshell/end4-pC
    without its git history; the shell's commit is recorded and is still in that history)
  - the Phoenix custom version that was installed
Restoring first saves a restore point of the current state ("Before undo"), so an undo can be undone. Then it puts the
settings back, undoes a Phoenix custom version installed since (custom-update undo), and reinstalls the old versions
of packages that changed from pacman's package cache (/var/cache/pacman/pkg, and yay's build cache for AUR packages)
with `sudo pacman -U` in a terminal window, where you confirm it and type your password. Packages that were added
since stay installed; versions no longer in the cache are listed and left as they are.
The file system isn't snapshotted: only these files and packages go back. The last 3 restore points are kept
(about 20 MB each) in ~/.local/state/phoenix/restore-points/.
"""
import datetime
import glob
import json
import hashlib
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
# The RESTORE_POINT_* overrides exist only to test on a scratch copy; TEST also skips the guard, reload, custom undo
# and prints the package command instead of running it.
ROOT = os.environ.get("RESTORE_POINT_ROOT", os.path.join(HOME, ".local", "state", "phoenix", "restore-points"))
CONFIG = os.environ.get("RESTORE_POINT_CONFIG", os.path.join(HOME, ".config"))
TEST = os.environ.get("RESTORE_POINT_TEST") == "1"
QS_REL = "quickshell/end4-pC"
SETTINGS = ["hypr", "illogical-impulse", QS_REL]          # relative to ~/.config
EXCLUDE = [f"{QS_REL}/.git", "*.bak*", "*.reapply-bak*", "hypr/custom/backups"]
RSYNC_EXCLUDE = {"hypr": ["*.bak*", "*.reapply-bak*", "/custom/backups/"], "illogical-impulse": ["*.bak*"],
                 QS_REL: ["/.git/", "*.bak*", "*.reapply-bak*"]}   # the same, relative to each folder
KEEP = 3
PKG_CACHES = ["/var/cache/pacman/pkg"]


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def packages():
    out = {}
    for line in run(["pacman", "-Q"]).stdout.splitlines():
        parts = line.split()
        if len(parts) == 2:
            out[parts[0]] = parts[1]
    return out


def shell_head():
    r = run(["git", "-C", os.path.join(CONFIG, QS_REL), "rev-parse", "HEAD"])
    return r.stdout.strip() if r.returncode == 0 else ""


def custom_label():
    for f in ("~/.local/state/custom-fixes/installed.json", "~/.local/share/custom-fixes/base.json"):
        try:
            with open(os.path.expanduser(f)) as fh:
                return str(json.load(fh).get("label") or "")
        except (OSError, ValueError):
            pass
    return ""


def settings_hash():
    """A fingerprint of the saved settings (the same files the archive holds), to tell whether they changed since."""
    h = hashlib.sha256()
    for s in SETTINGS:
        top = os.path.join(CONFIG, s)
        for root, dirs, files in os.walk(top):
            rel_root = os.path.relpath(root, CONFIG)
            dirs[:] = sorted(d for d in dirs if not (s == QS_REL and rel_root == QS_REL and d == ".git")
                             and not (rel_root == "hypr/custom" and d == "backups"))
            for f in sorted(files):
                if ".bak" in f or ".reapply-bak" in f:
                    continue
                path = os.path.join(root, f)
                try:
                    with open(path, "rb") as fh:
                        h.update(os.path.join(rel_root, f).encode() + b"\0" + hashlib.sha256(fh.read()).digest())
                except OSError:
                    pass
    return h.hexdigest()


def points():
    out = []
    if not os.path.isdir(ROOT):
        return out
    for name in sorted(os.listdir(ROOT), reverse=True):
        try:
            with open(os.path.join(ROOT, name, "meta.json")) as f:
                m = json.load(f)
            if os.path.isfile(os.path.join(ROOT, name, "settings.tar.zst")):
                out.append(m)
        except (OSError, ValueError):
            pass
    return out


def create(reason, keep=None):
    """Save a restore point; then delete the oldest beyond KEEP, never `keep` (the one being restored)."""
    os.makedirs(ROOT, exist_ok=True)
    now = datetime.datetime.now()
    # "<date>-<time>-NN", NN = one more than any point of the same second: ids sort in creation order (QA 2026-10-08:
    # "-10" sorted before "-2", and a bare id made after "-2" sorted first, so retention removed the newest)
    stamp = now.strftime("%Y%m%d-%H%M%S")
    taken = [int(n.rsplit("-", 1)[1]) for n in os.listdir(ROOT) if n.startswith(stamp + "-") and n.rsplit("-", 1)[1].isdigit()]
    taken += [1] if os.path.exists(os.path.join(ROOT, stamp)) else []
    pid = f"{stamp}-{max(taken, default=0) + 1:02d}"
    d = os.path.join(ROOT, pid)
    tmp = d + ".tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    with open(os.path.join(tmp, "packages.json"), "w") as f:
        json.dump(packages(), f)
    args = ["tar", "--zstd", "-cf", os.path.join(tmp, "settings.tar.zst"), "-C", CONFIG]
    args += [f"--exclude={e}" for e in EXCLUDE]
    args += [s for s in SETTINGS if os.path.exists(os.path.join(CONFIG, s))]
    r = run(args)
    if r.returncode not in (0, 1) or "Cowardly refusing" in r.stderr:   # 1 = a file changed while reading, still usable
        shutil.rmtree(tmp, ignore_errors=True)
        if not any(os.path.exists(os.path.join(CONFIG, x)) for x in SETTINGS):
            sys.exit("restore-point: there are no desktop settings to save")
        sys.exit(f"restore-point: saving the settings failed: {r.stderr.strip().splitlines()[0] if r.stderr.strip() else r.returncode}")
    meta = {"id": pid, "date": now.isoformat(timespec="seconds"), "reason": reason or "Restore point",
            "shell": shell_head(), "custom": custom_label(), "kernel": os.uname().release, "settings": settings_hash()}
    with open(os.path.join(tmp, "meta.json"), "w") as f:
        json.dump(meta, f)
    os.replace(tmp, d)
    for old in sorted(n for n in os.listdir(ROOT) if not n.endswith(".tmp") and n != keep)[:-KEEP]:
        shutil.rmtree(os.path.join(ROOT, old), ignore_errors=True)
    return pid


def cached_file(name, version):
    """The package file for name-version in pacman's or yay's cache, or None."""
    pats = [os.path.join(c, f"{name}-{version}-*.pkg.tar.*") for c in PKG_CACHES]
    pats.append(os.path.join(HOME, ".cache", "yay", "*", f"{name}-{version}-*.pkg.tar.*"))
    for pat in pats:
        for f in sorted(glob.glob(pat)):
            if not f.endswith(".sig"):
                # name-version-arch.pkg...: make sure "name" isn't the prefix of a longer package name
                rest = os.path.basename(f)[len(name) + len(version) + 2:]
                if rest.split(".pkg.tar")[0] in ("x86_64", "any"):
                    return f
    return None


def changes(pid):
    d = os.path.join(ROOT, pid)
    with open(os.path.join(d, "packages.json")) as f:
        then = json.load(f)
    with open(os.path.join(d, "meta.json")) as f:
        meta = json.load(f)
    now = packages()
    changed, missing = [], []
    for name, ver in sorted(then.items()):
        if now.get(name) != ver:
            item = {"name": name, "from": now.get(name, ""), "to": ver}
            (changed if cached_file(name, ver) else missing).append(item)
    added = sorted(n for n in now if n not in then)
    settings_changed = bool(meta.get("settings")) and meta.get("settings") != settings_hash()
    return {"packages": changed, "missing": missing, "added": added, "settings": settings_changed,
            "shell": bool(meta.get("shell")) and meta.get("shell") != shell_head(),
            "custom": meta.get("custom", "") != custom_label(), "customThen": meta.get("custom", "")}


def cmd_list():
    out = []
    for m in points():
        try:
            c = changes(m["id"])
        except (OSError, ValueError):
            continue
        m.update({"changedPackages": len(c["packages"]) + len(c["missing"]), "missingPackages": [p["name"] for p in c["missing"]],
                  "reinstallPackages": len(c["packages"]), "packages": c["packages"][:50], "shellChanged": c["shell"], "customChanged": c["custom"],
                  "settingsChanged": c["settings"]})
        out.append(m)
    print(json.dumps(out))


def restore_settings(pid, meta):
    d = os.path.join(ROOT, pid)
    tmp = tempfile.mkdtemp(prefix="restore-point-")
    try:
        r = run(["tar", "--zstd", "-xf", os.path.join(d, "settings.tar.zst"), "-C", tmp])
        if r.returncode != 0:
            sys.exit(f"restore-point: reading the saved settings failed: {r.stderr.strip()}")
        for s in SETTINGS:
            src = os.path.join(tmp, s)
            if not os.path.isdir(src):
                # a settings folder made after the point (e.g. illogical-impulse before the setup assistant ran) is
                # moved aside, not deleted, so the restore is complete and still undoable (RP-6). Never the shell itself.
                dst = os.path.join(CONFIG, s)
                if s != QS_REL and os.path.isdir(dst) and not os.path.islink(dst):
                    os.replace(dst, f"{dst}.bak-restore-{pid}")
                continue
            # --delete: files added since go away too; excluded ones (backups, the shell's git history) are left alone
            # --checksum: by content (a file changed within the same second, with the same size, used to be skipped)
            args = ["rsync", "-a", "--checksum", "--delete"] + [f"--exclude={e}" for e in RSYNC_EXCLUDE.get(s, [])]
            r = run(args + [src + "/", os.path.join(CONFIG, s) + "/"])
            if r.returncode != 0:
                sys.exit(f"restore-point: putting back {s} failed: {r.stderr.strip()}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    # the shell's git state follows the restored files: same commit, index matched, files untouched
    if meta.get("shell"):
        run(["git", "-C", os.path.join(CONFIG, QS_REL), "reset", "-q", "--mixed", meta["shell"]])


def cmd_restore(pid, yes):
    if not re.fullmatch(r"\d{8}-\d{6}(-\d+)?", pid):   # an id, not a path (QA 2026-10-08)
        sys.exit(f"restore-point: no restore point {pid}")
    d = os.path.join(ROOT, pid)
    try:
        with open(os.path.join(d, "meta.json")) as f:
            meta = json.load(f)
        c = changes(pid)
        when = str(meta["date"]).replace("T", " ")[:16]
        meta["reason"] = meta.get("reason", "Restore point")
        if not os.path.isfile(os.path.join(d, "settings.tar.zst")):
            raise OSError("settings.tar.zst is missing")
    except (OSError, ValueError, KeyError, TypeError) as e:
        sys.exit(f"restore-point: restore point {pid} is damaged and can't be used ({e})")
    print(f"Going back to the restore point of {when} ({meta['reason']}):")
    print(f"  - desktop settings and shell as they were then")
    if c["custom"] and c["customThen"]:
        print(f"  - Phoenix {custom_label()} undone (back to {c['customThen']})")
    if c["packages"]:
        print(f"  - {len(c['packages'])} package(s) back to their old version")
    if c["missing"]:
        print(f"  - not possible (no longer in the package cache): " + ", ".join(p["name"] for p in c["missing"]))
    if not yes:
        try:
            answer = input("Continue? [y/N] ")
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("y", "yes"):
            print("Nothing changed.")
            return 1
    before = create("Before undo", keep=pid)
    print(f"Saved the current state first (restore point {before}).")
    if c["custom"] and c["customThen"] and not TEST:
        subprocess.run([os.path.join(HOME, ".local", "bin", "custom-update"), "undo"])
    restore_settings(pid, meta)
    print("Desktop settings put back.")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and not TEST:
        run(["hyprctl", "reload"])
    if c["packages"]:
        files = [cached_file(p["name"], p["to"]) for p in c["packages"]]
        script = ("echo 'Putting back the old package versions (asks for your password):'; echo; "
                  f"sudo pacman -U {' '.join(shlex.quote(f) for f in files)}; rc=$?; echo; "
                  "if [ $rc -eq 0 ]; then echo 'Done. Log out and back in (or restart if the kernel changed) to finish.'; "
                  "else echo \"pacman stopped (exit code $rc): the packages were left as they are.\"; fi")
        if TEST:
            print("TEST: would run: sudo pacman -U " + " ".join(files))
        elif not sys.stdin.isatty() and os.environ.get("WAYLAND_DISPLAY") and shutil.which("kitty"):
            subprocess.Popen(["kitty", "--class", "phoenix-setup", "--title", "Restore point: packages", "bash", "-c",
                              script + "; read -rp 'Press Enter to close.'"],
                             start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print("A terminal window opened for the packages: confirm there and type your password.")
        else:
            subprocess.run(["bash", "-c", script])
    else:
        print("No packages to put back.")
    return 0


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else ""
    if cmd == "create":
        reason = a[a.index("--reason") + 1] if "--reason" in a and a.index("--reason") + 1 < len(a) else ""
        print(create(reason))
    elif cmd == "list":
        cmd_list()
    elif cmd == "restore" and len(a) >= 2:
        return cmd_restore(a[1], "--yes" in a)
    else:
        sys.exit(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main())
