#!/usr/bin/env python3
"""Install apps from the setup catalog (2026-10-03, ours).

  setup-apps list                 catalog as JSON (for the first-time setup wizard)
  setup-apps installed            ids of catalog apps that are installed (used by setup-profile export)
  setup-apps install <id>...      install apps; run it in a terminal, it asks for your password (sudo)
  setup-apps run <command>        terminal helper: drivers | update
  setup-apps drivers-plan [file]  which graphics drivers `run drivers` would install (file: saved `lspci -mm -n` output)

The catalog is ~/.local/share/setup-profiles/apps.json (pacman / aur / flatpak). Setup profiles list app ids in
"apps"; the wizard preselects those.
"""
import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CATALOG = os.path.join(HOME, ".local", "share", "setup-profiles", "apps.json")


def catalog():
    with open(CATALOG) as f:
        return json.load(f)


def is_installed(app):
    if app["kind"] == "flatpak":
        r = subprocess.run(["flatpak", "info", app["packages"][0]], capture_output=True)
        return r.returncode == 0
    return subprocess.run(["pacman", "-Qq", app["packages"][0]], capture_output=True).returncode == 0


def pause():
    try:
        input("\nPress Enter to close this window.")
    except EOFError:
        pass


def install(ids):
    apps = {a["id"]: a for a in catalog()["apps"]}
    chosen = [apps[i] for i in ids if i in apps]
    unknown = [i for i in ids if i not in apps]
    if unknown:
        print("Unknown applications (skipped): " + ", ".join(unknown))
    pac = [p for a in chosen if a["kind"] == "pacman" for p in a["packages"]]
    aur = [p for a in chosen if a["kind"] == "aur" for p in a["packages"]]
    flat = [p for a in chosen if a["kind"] == "flatpak" for p in a["packages"]]
    print("Installing: " + ", ".join(a["name"] for a in chosen) + "\n")
    rc = 0
    if pac:
        rc |= subprocess.run(["sudo", "pacman", "-S", "--needed", "--noconfirm", *pac]).returncode
    if aur:
        helper = shutil.which("yay") or shutil.which("paru")
        if helper:
            rc |= subprocess.run([helper, "-S", "--needed", "--noconfirm", *aur]).returncode
        else:
            print("No AUR helper (yay/paru): skipped " + ", ".join(aur))
            rc |= 1
    if flat:
        rc |= subprocess.run(["flatpak", "install", "-y", "--noninteractive", "flathub", *flat]).returncode
    print("\nInstallation completed." if rc == 0 else "\nSome applications could not be installed (see the output above).")
    pause()
    return rc


def drivers_plan(lspci_text=None):
    """(repo packages, AUR packages, notes) for the graphics hardware. Only display controllers (PCI class 03xx)
    count, by vendor ID: NVIDIA HDMI audio, Intel Wi-Fi or chipset parts don't (F12)."""
    if lspci_text is None:
        lspci_text = subprocess.run(["lspci", "-mm", "-n"], capture_output=True, text=True).stdout
    nvidia, intel = [], False
    for line in lspci_text.splitlines():
        f = [x.strip('"') for x in line.split()]
        if len(f) < 4 or not f[1].startswith("03"):
            continue
        vendor, device = f[2].lower(), f[3].lower()
        if vendor == "10de":
            nvidia.append(int(device, 16))
        elif vendor == "8086":
            intel = True
    pkgs, aur, notes = [], [], []
    if nvidia:
        newest = max(nvidia)
        # NVIDIA device IDs rise with each generation: Turing (2018) starts at 0x1e00; Maxwell, Pascal and Volta are
        # 0x1340-0x1dff (not supported by nvidia-open; the 580xx driver is their last one); Kepler and older below.
        if newest >= 0x1E00:
            pkgs += ["nvidia-open-dkms", "nvidia-utils", "lib32-nvidia-utils", "linux-headers"]
        elif newest >= 0x1340:
            pkgs += ["linux-headers"]
            aur += ["nvidia-580xx-dkms", "nvidia-580xx-utils", "lib32-nvidia-580xx-utils"]
            notes.append("NVIDIA Maxwell, Pascal or Volta card (for example GTX 750, 900 or 10 series): using the 580xx driver, the newest one for these cards.")
        else:
            notes.append("This NVIDIA card is a Kepler or older model (for example GTX 600 or most of the 700 series). No current driver supports "
                         "it, so the built-in open-source driver (nouveau) stays in use.")
    if intel:
        pkgs += ["vulkan-intel", "lib32-vulkan-intel", "intel-media-driver"]
    return pkgs, aur, notes


def run(what):
    if what == "drivers":
        pkgs, aur, notes = drivers_plan()
        for n in notes:
            print(n)
        if not pkgs and not aur:
            if not notes:
                print("No additional graphics drivers are required (AMD and generic graphics are supported).")
            pause()
            return 0
        print("Installing graphics drivers: " + " ".join(pkgs + aur) + "\n")
        rc = subprocess.run(["sudo", "pacman", "-S", "--needed", "--noconfirm", *pkgs]).returncode if pkgs else 0
        if aur:
            helper = shutil.which("yay") or shutil.which("paru")
            if helper:
                rc |= subprocess.run([helper, "-S", "--needed", "--noconfirm", *aur]).returncode
            else:
                print("No AUR helper (yay/paru): install " + ", ".join(aur) + " from the AUR.")
                rc |= 1
        print("\nCompleted. Restart the computer to use the new driver." if rc == 0 else "\nThe driver could not be installed.")
        pause()
        return rc
    if what == "update":
        updater = os.path.join(HOME, ".local", "bin", "system-update")
        cmd = [updater] if os.access(updater, os.X_OK) else ["sudo", "pacman", "-Syu"]
        rc = subprocess.run(cmd).returncode
        pause()
        return rc
    sys.exit(__doc__)


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "list"
    if cmd == "list":
        json.dump(catalog(), sys.stdout)
    elif cmd == "installed":
        print("\n".join(app["id"] for app in catalog()["apps"] if is_installed(app)))
    elif cmd == "install" and len(a) > 1:
        sys.exit(install(a[1:]))
    elif cmd == "drivers-plan":
        text = open(a[1]).read() if len(a) > 1 else None
        pkgs, aur, notes = drivers_plan(text)
        print(json.dumps({"packages": pkgs, "aur": aur, "notes": notes}))
    elif cmd == "run" and len(a) == 2:
        sys.exit(run(a[1]))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
