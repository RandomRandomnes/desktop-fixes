{
    "format": "end4-setup-profile",
    "version": 1,
    "name": "Default",
    "description": "Windows-style desktop with the standard illogical-impulse appearance: floating windows with title bars, minimizing to the dock, an application grid in the Super menu, a static wallpaper and monochrome colors. Additional features can be enabled in Settings \u203a Extras.",
    "author": "RandomRandomnes",
    "look": "stock",
    "features": {
        "windowsStyle": true,
        "minimizeToDock": true,
        "wallpaperEngine": false,
        "resourceGraphs": false,
        "appGrid": true,
        "powerMenuKde": false,
        "claudeCodeAi": false,
        "updatesScript": true,
        "steamTray": false,
        "wallpaperEngineCard": true,
        "deviceBatteries": true,
        "desktopSwitch": false
    },
    "settings": {
        "dock": {
            "enable": true
        },
        "appearance": {
            "palette": {
                "type": "scheme-monochrome"
            }
        }
    },
    "wallpaper": "@default",
    "apps": []
}
