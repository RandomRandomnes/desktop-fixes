#!/bin/sh
# The Wallpaper Engine app's own login entry (~/.config/autostart, written by the app, used by KDE) starts
# "linux-wallpaper-engine"; this hands it to linux-wallpaper-engine-ux next to it (Phoenix's tray-icon fix).
# Was a symlink (2026-10-08): releases copied it as a second full copy of that script.
exec "$(dirname "$(readlink -f "$0")")/linux-wallpaper-engine-ux" "$@"
